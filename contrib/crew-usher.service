# Install: copy to ~/.config/systemd/user/ then `systemctl --user enable --now crew-usher`.
[Unit]
Description=crew usher: admission control for agent jobs
After=graphical-session.target

[Service]
# Owner idle detection reads WAYLAND_DISPLAY from the user manager: `systemctl --user import-environment WAYLAND_DISPLAY`.
ExecStart=%h/.cargo/bin/crew-usher
Restart=on-failure

[Install]
WantedBy=default.target
